{
  "name": "skillsense",
  "version": "0.1.1",
  "description": "Install the right AI skills for your project stack in one command",
  "type": "module",
  "bin": {
    "skillsense": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cli",
    "ai",
    "skills",
    "claude",
    "copilot",
    "opencode",
    "developer-tools",
    "stack-detection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresquirogadev/skillsense.git"
  },
  "homepage": "https://github.com/andresquirogadev/skillsense#readme",
  "bugs": {
    "url": "https://github.com/andresquirogadev/skillsense/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
